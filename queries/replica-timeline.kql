// Part 2 (and the seed for the timeline page later in the series):
// every time the replica count changed, in which direction, from what to what.
AzureMetrics
| where TimeGenerated > ago(7d)
| where ResourceProvider == "MICROSOFT.APP" and MetricName == "Replicas"
| summarize Replicas = max(Maximum) by Resource, TimeGenerated = bin(TimeGenerated, 1m)
| order by Resource asc, TimeGenerated asc
| extend Previous = prev(Replicas), PreviousResource = prev(Resource)
| where Resource == PreviousResource and Replicas != Previous
| extend Direction = iff(Replicas > Previous, "scale-out", "scale-in")
| project TimeGenerated, Resource, Previous, Replicas, Direction
| order by TimeGenerated desc
