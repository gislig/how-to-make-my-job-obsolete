// Part 2: what "normal" looks like for each hour of the week (0 = Sunday 00:00 UTC).
// The agent uses this table to judge whether a scaling decision fits the pattern or is a real anomaly.
let app = "ca-aiops-demo-web";
let lookback = 28d;
let requests = AzureMetrics
    | where TimeGenerated > ago(lookback)
    | where ResourceProvider == "MICROSOFT.APP" and MetricName == "Requests" and Resource =~ app
    | summarize Requests = sum(Total) by TimeGenerated = bin(TimeGenerated, 1h);
let replicas = AzureMetrics
    | where TimeGenerated > ago(lookback)
    | where ResourceProvider == "MICROSOFT.APP" and MetricName == "Replicas" and Resource =~ app
    | summarize Replicas = max(Maximum) by TimeGenerated = bin(TimeGenerated, 1h);
requests
| join kind=leftouter replicas on TimeGenerated
| extend HourOfWeek = toint(dayofweek(TimeGenerated) / 1h) + hourofday(TimeGenerated)
| summarize
    P50Requests = percentile(Requests, 50),
    P95Requests = percentile(Requests, 95),
    P95Replicas = percentile(Replicas, 95),
    Samples = count()
    by HourOfWeek
| order by HourOfWeek asc
