// Part 2: your own baseline next to Azure Monitor's dynamic thresholds.
// Requests per 5 minutes over 14 days, decomposed into seasonality + trend, with anomalies flagged.
// Source: AzureMetrics (the container app's diagnostic setting sends AllMetrics there).
let app = "ca-aiops-demo-web";
AzureMetrics
| where TimeGenerated > ago(14d)
| where ResourceProvider == "MICROSOFT.APP" and MetricName == "Requests"
| where Resource =~ app
| make-series Requests = sum(Total) default = 0 on TimeGenerated step 5m
| extend (Anomalies, Score, Baseline) = series_decompose_anomalies(Requests, 2.5, -1, 'linefit')
| render anomalychart with (anomalycolumns = Anomalies, title = "Requests vs learned baseline")
